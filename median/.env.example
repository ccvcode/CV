# ---------------------------------------------------------------- site
# Domeniul (fără https://). Caddy obține automat certificatul HTTPS.
MEDIAN_DOMAIN=median.ro
MEDIAN_SITE_URL=https://median.ro
MEDIAN_CONTACT_EMAIL=redactia@median.ro
# Editorul (firma), afișat pe paginile Despre și Contact.
MEDIAN_COMPANY=
# Parola panoului /admin (minimum 8 caractere) și un secret lung aleator pentru sesiuni.
ADMIN_PASSWORD=
MEDIAN_SECRET=

# ---------------------------------------------------------------- redactorul AI
# Orice API compatibil OpenAI. Implicit: DeepSeek (https://platform.deepseek.com).
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-flash
# Parametri suplimentari trimiși modelului (DeepSeek: fără „thinking” pentru viteză și cost).
LLM_EXTRA={"thinking":{"type":"disabled"}}
# „json_object” pentru DeepSeek; „json_schema” pentru Ollama, llama.cpp sau Scaleway.
LLM_JSON_MODE=json_object
# Plafoane: cost maxim pe zi (USD) și număr maxim de articole/știri scurte pe zi.
LLM_DAILY_BUDGET_USD=3
LLM_MAX_ARTICLES_PER_DAY=150
LLM_MAX_BRIEFS_PER_DAY=300
# Prețurile modelului (USD per 1M tokeni), doar pentru evidența costurilor din /admin.
LLM_PRICE_INPUT=0.3
LLM_PRICE_OUTPUT=1.2

# Verificatorul poate folosi alt model (ex. unul mai puternic). Implicit = redactorul.
# VERIFY_BASE_URL=https://api.deepseek.com
# VERIFY_MODEL=deepseek-v4-pro

# Alternativă găzduită în UE (GDPR): Scaleway (Paris)
# LLM_BASE_URL=https://api.scaleway.ai/v1
# LLM_MODEL=deepseek-v4-flash-0731
# LLM_JSON_MODE=json_schema
# LLM_EXTRA={}

# Alternativă locală (Ollama pe același server; necesită server puternic, ideal cu GPU)
# LLM_BASE_URL=http://ollama:11434/v1
# LLM_MODEL=gemma4:26b
# LLM_API_KEY=ollama
# LLM_JSON_MODE=json_schema
# LLM_EXTRA={}

# ---------------------------------------------------------------- imagini
# Chei gratuite pentru fotografii de ilustrare (opționale; fără ele: Wikimedia Commons + coperte generate).
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=
# „thumb” (recomandat): pozele publicațiilor apar doar ca miniaturi cu credit.
# „hero”: pot fi și poza principală — doar dacă ai acordul publicațiilor.
MEDIAN_SOURCE_IMAGES=thumb

# ---------------------------------------------------------------- redacție
# 1 = subiectele sensibile (decese, minori, justiție) așteaptă aprobarea în /admin.
MEDIAN_REVIEW_SENSITIVE=1
