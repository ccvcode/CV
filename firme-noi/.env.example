# Copiază acest fișier în „.env" și completează valorile.
#   cp .env.example .env

# --- Baza de date ---
FIRME_DB=data/firme.db

# --- ANAF (API public, nu necesită cheie) ---
ANAF_BASE_URL=https://webservicesp.anaf.ro/api
ANAF_VERSION=v9
# ANAF acceptă maxim ~1 cerere/secundă și maxim 100 CUI-uri per cerere.
ANAF_BATCH_SIZE=100
ANAF_MIN_INTERVAL=1.2

# --- Sursa ONRC (data.gov.ro) ---
# Lasă gol ca sistemul să descopere automat cel mai recent set de date,
# sau pune URL-ul direct către fișierul OD_FIRME.csv dacă îl ai.
ONRC_CSV_URL=

# --- Găsire telefoane (opțional) ---
# Ordinea providerilor încercați: anaf,google,web
PHONE_PROVIDERS=anaf
# Cheie Google Maps/Places – necesară doar pentru providerul „google".
GOOGLE_MAPS_API_KEY=

# --- General ---
HTTP_TIMEOUT=30
USER_AGENT=firme-noi/1.0 (colectare date publice)
